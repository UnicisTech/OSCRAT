generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Authentication & User Models

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  emailVerified DateTime?
  password      String?
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now())
  firstName     String       @default("")
  lastName      String       @default("")
  accounts      Account[]
  Comment       Comment[]
  invitations   Invitation[]
  sessions      Session[]
  authoredTasks Task[]       @relation("TaskAuthor")
  assignedTasks Task[]       @relation("TaskAssignee")
  teamMembers   TeamMember[]

  createdOscratProducts           OscratProduct[]               @relation("OscratProductCreatedBy")
  updatedOscratProducts           OscratProduct[]               @relation("OscratProductUpdatedBy")
  createdOscratProductVersions    OscratProductVersion[]        @relation("OscratProductVersionCreatedBy")
  updatedOscratProductVersions    OscratProductVersion[]        @relation("OscratProductVersionUpdatedBy")
  createdOscratAssessments        OscratAssessment[]            @relation("OscratAssessmentCreatedBy")
  createdOscratReportingOrgs      OscratReportingOrganization[] @relation("OscratReportingOrganizationCreatedBy")
  updatedOscratReportingOrgs      OscratReportingOrganization[] @relation("OscratReportingOrganizationUpdatedBy")
  createdOscratVulnerabilities    OscratProductVulnerability[]  @relation("OscratProductVulnerabilityCreatedBy")
  updatedOscratVulnerabilities    OscratProductVulnerability[]  @relation("OscratProductVulnerabilityUpdatedBy")
  createdOscratIncidents          OscratProductIncident[]       @relation("OscratProductIncidentCreatedBy")
  updatedOscratIncidents          OscratProductIncident[]       @relation("OscratProductIncidentUpdatedBy")
  reportedIncidents               OscratProductIncident[]       @relation("OscratProductIncidentReporter")
  triggeredWorkerJobs             WorkerJob[]                   @relation("WorkerJobTriggeredBy")
  createdAttachments              Attachment[]                  @relation("AttachmentCreatedBy")
  updatedTeamData                 TeamData[]                    @relation("TeamDataUpdatedBy")
  createdDocumentation            Documentation[]               @relation("DocumentationCreatedBy")
  updatedDocumentation            Documentation[]               @relation("DocumentationUpdatedBy")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
}

// Team & Task Management Models

model Team {
  id                 String              @id @default(uuid())
  taskIndex          Int                 @default(1)
  name               String
  slug               String              @unique
  domain             String?             @unique
  defaultRole        Role                @default(MEMBER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now())
  properties         Json                @default("{}")

  type               OscratOrganizationType   @default(OTHER)
  size               OscratOrganizationSize   @default(SMALL_ENTERPRISE)
  orgRoles           OscratOrganizationRole[] @default([MANUFACTURER])

  taxId              String?
  postalAddress      String?
  contactEmail       String?
  contactPhone       String?
  additionalInformation String?

  apiKeys            ApiKey[]
  invitations        Invitation[]
  tasks              Task[]
  members            TeamMember[]

  // Relationships from OscratOrganization
  products                    OscratProduct[]
  productVersions             OscratProductVersion[]
  repositories                OscratRepository[]
  reportingOrganizations      OscratReportingOrganization[]
  workerJobs                  WorkerJob[]
  incidents                   OscratProductIncident[] @relation("TeamIncidents")
  assessments                 OscratAssessment[]
  teamData                    TeamData[]
  auditLogs                   AuditLog[]
  documentation               Documentation[]
}

model Task {
  id          Int          @id @default(autoincrement())
  taskNumber  Int
  teamId      String
  authorId    String
  assigneeId  String?
  title       String
  titleLocId  String?
  status      TaskStatus   @default(TODO)
  duedate     String
  description    String
  descriptionLocId String?
  properties  Json
  
  productId   String?
  versionId   String?
  version     OscratProductVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  
  originType  TaskOriginType @default(MANUAL)
  
  attachments Attachment[]
  comments    Comment[]
  author      User         @relation("TaskAuthor", fields: [authorId], references: [id])
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  linkedDocumentation DocumentationTask[]
  
  @@index([taskNumber, teamId])
}

model Comment {
  id          Int      @id @default(autoincrement())
  text        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  taskId      Int
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}


model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  lastAwarenessTrainingCompletion DateTime?
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model Invitation {
  id        String   @id @default(uuid())
  teamId    String
  email     String
  role      Role     @default(MEMBER)
  token     String   @unique
  expires   DateTime
  invitedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  user      User     @relation(fields: [invitedBy], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  teamId     String
  hashedKey  String    @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())
  expiresAt  DateTime?
  lastUsedAt DateTime?
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

// Enums

enum Role {
  ADMIN
  OWNER
  MEMBER
  AUDITOR
}

enum OscratOrganizationRole {
  MANUFACTURER
  DISTRIBUTOR
  IMPORTER
  DATA_STEWARD
  AUTHORIZED_REPRESENTATIVE
}

enum OscratOrganizationType {
  NATURAL_PERSON
  LIMITED_LIABILITY_COMPANY
  PUBLIC_LIMITED_COMPANY
  PARTNERSHIP
  OPEN_SOURCE_FOUNDATION
  OPEN_SOURCE_STEWARD
  NON_PROFIT_ORGANIZATION
  ACADEMIC_INSTITUTION
  PUBLIC_BODY
  OTHER
}

enum OscratOrganizationSize {
  MICRO_ENTERPRISE
  SMALL_ENTERPRISE
  MEDIUM_ENTERPRISE
  OTHER
}

enum OscratProductCategory {
  DEFAULT
  IMPORTANT_CLASS_I
  IMPORTANT_CLASS_II
  CRITICAL
}

enum OscratProductRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OscratProductComplianceStatus {
  NOT_ASSESSED
  IN_PROGRESS
  COMPLIANT
  NON_COMPLIANT
  PENDING_CERTIFICATION
  CERTIFIED
}

enum OscratProductType {
  CONNECTED_DEVICE
  IOT_DEVICE
  SMART_HOME_DEVICE
  WEARABLE_DEVICE
  INDUSTRIAL_DEVICE
  SECURITY_HARDWARE
  APPLICATION_SOFTWARE
  SYSTEM_SOFTWARE
  SECURITY_SOFTWARE
  EMBEDDED_SOFTWARE
  FIRMWARE
  HARDWARE_WITH_SOFTWARE
  REMOTE_DATA_PROCESSING
}

enum OscratProductStatus {
  ACTIVE
  INACTIVE
}

enum OscratConformityProcedure {
  SELF_ASSESSMENT
  THIRD_PARTY_OPTIONAL
  THIRD_PARTY_MANDATORY
  EUCC_CERTIFICATION
}

enum OscratAssessmentType {
  CRA
  ORG
  COMPLIANCE
}

enum OscratProductVulnerabilitySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OscratProductVulnerabilityStatus {
  PENDING
  PREPARATION
  RECEIPT
  VERIFICATION
  REMEDIATION_DEVELOPMENT
  RELEASE
  POST_RELEASE
}

enum IncidentStatus {
  PENDING
  START
  DECLARED
  STABLE
  ACTIVE
  RESOLVED
  COMPLETED
}

enum IncidentClassification {
  GENERAL
  CONFIDENTIALITY
  INTEGRITY
  AVAILABILITY
  ACCESS_CONTROL
  VULNERABILITIES
  TECHNICAL_FAILURE
  THEFT_OR_LOSS
}

enum IncidentAttackType {
  DENIAL_OF_SERVICE
  UNAUTHORISED_ACCESS
  MALWARE
  ABUSE
  OTHERS
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OscratRepositoryProvider {
  GITHUB
  GITLAB
  BITBUCKET
}

enum OscratRepositoryAuthType {
  PERSONAL_ACCESS_TOKEN
  PUBLIC
}

enum WorkerJobType {
  REPO_GENERATE_SBOM
  FILE_IMPORT_SBOM
  REPO_SCAN_VULNERABILITIES
  SBOM_REPORT_SCAN_VULNERABILITIES
  PROCESS_CONFIGURATION_SCAN
}

enum WorkerJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskStatus {
  TODO
  PLANNED
  IN_PROGRESS
  DONE
}

enum TaskOriginType {
  MANUAL
  AUTOMATIC
}

enum DocumentationVisibility {
  PRIVATE
  PUBLIC
}

enum DocumentationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AuditUserType {
  USER
  API_KEY
  SYSTEM
}

enum OscratProductVersionStatus {
  DRAFT
  ACTIVE
  DEPRECATED
  ARCHIVED
  WITHDRAWN
  SUPPORTED
}


// OSCRAT Models

// OscratOrganization model removed - merged into Team

model OscratProduct {
  id          String  @id @default(uuid())
  name        String
  acronym     String  @default("")
  description String  @default("")

  teamId String
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  type                   OscratProductType
  reportingOrganizations OscratReportingOrganization[]
  productCategory        OscratProductCategory         @default(DEFAULT)
  complianceStatus       OscratProductComplianceStatus @default(NOT_ASSESSED)
  conformityProcedure    OscratConformityProcedure     @default(SELF_ASSESSMENT)
  riskLevel              OscratProductRiskLevel        @default(LOW)
  versions               OscratProductVersion[]
  workerJobs             WorkerJob[]
  status                 OscratProductStatus           @default(ACTIVE)
  documentation          Documentation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  createdByUser User @relation("OscratProductCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User @relation("OscratProductUpdatedBy", fields: [updatedBy], references: [id])
}

model OscratProductVersion {
  id String @id @default(uuid())

  version String
  status  OscratProductVersionStatus @default(DRAFT)
  releaseDate    DateTime?
  supportEndDate DateTime?

  productId String
  product   OscratProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  teamId String
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  assessments              OscratAssessment[]
  vulnerabilities          OscratProductVulnerability[]
  incidents                OscratProductIncident[]
  repository               OscratRepository?
  sbomReports              SbomReport[]
  vulnerabilityScanReports VulnerabilityScanReport[]
  configurationScanReports ConfigurationScanReport[]
  attachments              Attachment[]
  workerJobs               WorkerJob[]
  tasks                    Task[]
  documentation            Documentation[]

  // Conformity Assessment Report (prerequisite for DoC)
  conformityAssessmentReportId String?    @unique
  conformityAssessmentReport   Attachment? @relation("VersionCAR", fields: [conformityAssessmentReportId], references: [id], onDelete: SetNull)

  // Declaration of Conformity (final PDF)
  declarationOfConformityId String?    @unique
  declarationOfConformity   Attachment? @relation("VersionDoC", fields: [declarationOfConformityId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  createdByUser User @relation("OscratProductVersionCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User @relation("OscratProductVersionUpdatedBy", fields: [updatedBy], references: [id])

  @@index([productId])
  @@index([status])
  @@index([productId, status])
  @@index([productId, createdAt])
  @@index([teamId, id])
}

model OscratAssessment {
  id String @id @default(uuid())

  type          OscratAssessmentType
  schemaVersion String
  rawData       Json

  teamId String
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  productId String? // Optional - null for ORG type
  versionId String? // Optional - null for ORG and CRA types
  version   OscratProductVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  createdBy String

  createdByUser User @relation("OscratAssessmentCreatedBy", fields: [createdBy], references: [id])

  @@index([teamId])
  @@index([productId])
  @@index([versionId])
  @@index([teamId, type])
  @@index([versionId, type])
}

model OscratReportingOrganization {
  id             String @id @default(uuid())
  name           String
  acronym        String
  reportingEmail String

  teamId String
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  assignedProducts OscratProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  createdByUser User @relation("OscratReportingOrganizationCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User @relation("OscratReportingOrganizationUpdatedBy", fields: [updatedBy], references: [id])
}

model OscratProductVulnerability {
  id String @id @default(uuid())

  name           String
  description    String
  severity       OscratProductVulnerabilitySeverity
  status         OscratProductVulnerabilityStatus
  cve            String?
  affectedVendor String?
  references     String[]

  advisoryId            String?
  dateOfDiscovery       DateTime
  affectedMemberStates  String[]

  versionId String
  version   OscratProductVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  productId String // Denormalized for easier queries

  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  createdByUser User @relation("OscratProductVulnerabilityCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User @relation("OscratProductVulnerabilityUpdatedBy", fields: [updatedBy], references: [id])

  @@index([versionId])
  @@index([productId])
  @@index([versionId, status])
  @@index([productId, status])
}

model OscratProductIncident {
  id String @id @default(uuid())

  status         IncidentStatus
  classification IncidentClassification
  attackType     IncidentAttackType
  assetDetails   String?

  reporterId String
  reporter   User @relation("OscratProductIncidentReporter", fields: [reporterId], references: [id])

  dateOfDetection DateTime
  severity        IncidentSeverity
  handlingDate    DateTime?

  description        String
  correctiveActions  String?
  rootCause          String?
  scope              String
  preventiveActions  String?

  suspectedUnlawfulAct     Boolean @default(false)
  unlawfulActDescription   String?
  crossBorderImpact        Boolean @default(false)
  crossBorderImpactDetails String?

  versionId String
  version   OscratProductVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  productId String // Denormalized for easier queries

  teamId String
  team   Team @relation("TeamIncidents", fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  createdByUser User @relation("OscratProductIncidentCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User @relation("OscratProductIncidentUpdatedBy", fields: [updatedBy], references: [id])

  attachments Attachment[]

  @@index([versionId])
  @@index([productId])
  @@index([teamId])
  @@index([versionId, status])
  @@index([productId, status])
  @@index([teamId, status])
  @@index([teamId, dateOfDetection])
  @@index([dateOfDetection])
  @@index([severity])
}

model OscratRepository {
  id String @id @default(uuid())

  name          String
  provider      OscratRepositoryProvider
  repositoryUrl String
  user          String

  targetBranch String?
  targetTag    String?
  targetCommit String?

  authType    OscratRepositoryAuthType @default(PERSONAL_ACCESS_TOKEN)
  accessToken String?
  
  teamId String
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  versionId String        @unique
  version   OscratProductVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  productId String // Denormalized for easier queries

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([teamId, versionId])
  @@index([teamId, productId])
}

// Worker Job Models

model WorkerJob {
  id String @id @default(uuid())

  type   WorkerJobType
  status WorkerJobStatus @default(PENDING)

  triggeredByUserId String
  triggeredByUser   User   @relation("WorkerJobTriggeredBy", fields: [triggeredByUserId], references: [id])

  // Context fields - team is mandatory, others optional
  contextTeamId    String
  contextTeam      Team @relation(fields: [contextTeamId], references: [id], onDelete: Cascade)

  contextProductId String?
  contextProduct   OscratProduct? @relation(fields: [contextProductId], references: [id], onDelete: Cascade)

  contextVersionId String?
  contextVersion   OscratProductVersion? @relation(fields: [contextVersionId], references: [id], onDelete: Cascade)

  processStartTime DateTime?
  processEndTime   DateTime?
  createdAt        DateTime  @default(now())

  payload    Json
  result     Json?
  errMessage String?
  errCode    String?

  sbomReport              SbomReport? @relation("SbomReportJob")
  vulnerabilityScanReport VulnerabilityScanReport? @relation("VulnerabilityScanReportJob")
  configurationScanReport ConfigurationScanReport? @relation("ConfigurationScanReportJob")

  @@index([status, type])
  @@index([contextVersionId, type])
  @@index([contextProductId, type])
  @@index([contextTeamId, type])
}

model SbomReport {
  id String @id @default(uuid())

  jobId String    @unique
  job   WorkerJob @relation("SbomReportJob", fields: [jobId], references: [id], onDelete: Cascade)

  versionId String
  version   OscratProductVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  productId String // Denormalized for easier queries

  sbomData Json?

  attachment Attachment?

  vulnerabilityScans VulnerabilityScanReport[] @relation("SbomToVulnerabilityScan")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([versionId])
  @@index([productId])
  @@index([versionId, createdAt])
  @@index([productId, createdAt])
}

model VulnerabilityScanReport {
  id String @id @default(uuid())

  jobId String    @unique
  job   WorkerJob @relation("VulnerabilityScanReportJob", fields: [jobId], references: [id], onDelete: Cascade)

  versionId String
  version   OscratProductVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  productId String // Denormalized for easier queries

  scanData Json?

  attachment Attachment?

  sourceSbomReportId String?
  sourceSbomReport   SbomReport? @relation("SbomToVulnerabilityScan", fields: [sourceSbomReportId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([versionId])
  @@index([productId])
  @@index([versionId, createdAt])
  @@index([productId, createdAt])
  @@index([sourceSbomReportId])
}

enum ConfigurationScanFormat {
  ARF
  XCCDF
  OVAL
}

model ConfigurationScanReport {
  id String @id @default(uuid())

  jobId String    @unique
  job   WorkerJob @relation("ConfigurationScanReportJob", fields: [jobId], references: [id], onDelete: Cascade)

  versionId String
  version   OscratProductVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  productId String

  format        ConfigurationScanFormat
  formatVersion String

  scanData Json?

  attachment Attachment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([versionId])
  @@index([productId])
  @@index([versionId, createdAt])
  @@index([productId, createdAt])
}

// TeamData Model - Generic JSON storage per team

model TeamData {
  id        String   @id @default(uuid())

  dataKey   String
  payload   Json

  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String

  updatedByUser User @relation("TeamDataUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([teamId, dataKey])
  @@index([teamId])
  @@index([dataKey])
}

// File Models

model File {
  id String @id @default(uuid())

  fileData Bytes
  fileSize Int
  mimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachment Attachment?
}

// Unified Attachment model
model Attachment {
  id String @id @default(uuid())
  
  // Display metadata - stored here for UI performance
  name        String
  fileSize    Int
  mimeType    String?
  description String?
  url         String?
  
  fileId String @unique
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  
  // Polymorphic associations
  taskId Int?
  task   Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  versionId String?
  version   OscratProductVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)

  sbomReportId String? @unique
  sbomReport   SbomReport? @relation(fields: [sbomReportId], references: [id], onDelete: Cascade)

  vulnerabilityScanReportId String? @unique
  vulnerabilityScanReport   VulnerabilityScanReport? @relation(fields: [vulnerabilityScanReportId], references: [id], onDelete: Cascade)

  configurationScanReportId String? @unique
  configurationScanReport   ConfigurationScanReport? @relation(fields: [configurationScanReportId], references: [id], onDelete: Cascade)

  incidentId String?
  incident   OscratProductIncident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  vulnerabilityId String?
  vulnerability   OscratProductVulnerability? @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)

  documentationId String?
  documentation   Documentation? @relation(fields: [documentationId], references: [id], onDelete: Cascade)

  // Reverse relations for CAR and DoC
  versionAsCAR OscratProductVersion? @relation("VersionCAR")
  versionAsDoC OscratProductVersion? @relation("VersionDoC")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  createdByUser User @relation("AttachmentCreatedBy", fields: [createdBy], references: [id])

  @@index([taskId])
  @@index([versionId])
  @@index([sbomReportId])
  @@index([vulnerabilityScanReportId])
  @@index([configurationScanReportId])
  @@index([incidentId])
  @@index([vulnerabilityId])
  @@index([documentationId])
  @@index([name])
}

// Documentation Models

model Documentation {
  id          String   @id @default(uuid())
  slug        String

  title       String
  content     String   @default("")

  visibility  DocumentationVisibility @default(PRIVATE)
  status      DocumentationStatus     @default(DRAFT)

  // Version tracking (simple incrementing version number)
  version     Int      @default(1)

  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // Optional product/version association (for PRODUCT level)
  productId   String?
  product     OscratProduct? @relation(fields: [productId], references: [id], onDelete: Cascade)

  versionId   String?
  productVersion OscratProductVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)

  // Task backlinks (many-to-many)
  linkedTasks DocumentationTask[]

  // Attachments
  attachments Attachment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String
  updatedBy   String

  createdByUser User @relation("DocumentationCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User @relation("DocumentationUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([teamId, slug])
  @@index([teamId])
  @@index([teamId, status])
  @@index([productId])
  @@index([versionId])
}

// Junction table for Documentation <-> Task many-to-many relationship
model DocumentationTask {
  id              String   @id @default(uuid())

  documentationId String
  documentation   Documentation @relation(fields: [documentationId], references: [id], onDelete: Cascade)

  taskId          Int
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@unique([documentationId, taskId])
  @@index([documentationId])
  @@index([taskId])
}

model AuditLog {
  id          String   @id @default(uuid())

  userId      String
  userType    AuditUserType @default(USER)
  userName    String?
  userEmail   String?

  action      String
  crud        String
  targetType  String
  targetId    String?
  targetName  String?

  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  productId   String?
  productName String?
  versionId   String?
  versionName String?
  metadata    Json?

  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([teamId, createdAt(sort: Desc)])
  @@index([teamId, action])
  @@index([teamId, targetType])
  @@index([teamId, productId])
  @@index([teamId, versionId])
  @@index([userId])
  @@index([targetType, targetId])
}
