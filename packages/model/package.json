{
  "name": "@oscrat/model",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "reset": "dotenv -e ../../.env -- prisma migrate reset",
    "reset:force": "dotenv -e ../../.env -- prisma migrate reset --force",
    "seed:oscrat": "dotenv -e ../../.env -- npx tsx prisma/seed-oscrat.ts",
    "build": "dotenv -e ../../.env -- prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.7.0",
    "tsx": "^4.20.3"
  }
}
