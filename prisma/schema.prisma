generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  emailVerified DateTime?
  password      String?
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now())
  firstName     String       @default("")
  lastName      String       @default("")
  accounts      Account[]
  Comment       Comment[]
  invitations   Invitation[]
  sessions      Session[]
  Task          Task[]
  teamMembers   TeamMember[]

  // OSCRAT relations
  createdOscratOrganizations      OscratOrganization[]          @relation("OscratOrganizationCreatedBy")
  updatedOscratOrganizations      OscratOrganization[]          @relation("OscratOrganizationUpdatedBy")
  createdOscratProducts           OscratProduct[]               @relation("OscratProductCreatedBy")
  updatedOscratProducts           OscratProduct[]               @relation("OscratProductUpdatedBy")
  createdOscratProductAssessments OscratProductAssessment[]     @relation("OscratProductAssessmentCreatedBy")
  createdOscratReportingOrgs      OscratReportingOrganization[] @relation("OscratReportingOrganizationCreatedBy")
  updatedOscratReportingOrgs      OscratReportingOrganization[] @relation("OscratReportingOrganizationUpdatedBy")
  createdOscratVulnerabilities    OscratProductVulnerability[]  @relation("OscratProductVulnerabilityCreatedBy")
  updatedOscratVulnerabilities    OscratProductVulnerability[]  @relation("OscratProductVulnerabilityUpdatedBy")
  createdOscratIncidents          OscratProductIncident[]       @relation("OscratProductIncidentCreatedBy")
  updatedOscratIncidents          OscratProductIncident[]       @relation("OscratProductIncidentUpdatedBy")
}

model Team {
  id                 String              @id @default(uuid())
  taskIndex          Int                 @default(1)
  name               String
  slug               String              @unique
  domain             String?             @unique
  defaultRole        Role                @default(MEMBER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now())
  properties         Json                @default("{}")
  apiKeys            ApiKey[]
  invitations        Invitation[]
  tasks              Task[]
  members            TeamMember[]
  oscratOrganization OscratOrganization?
}

model Task {
  id          Int          @id @default(autoincrement())
  taskNumber  Int
  teamId      String
  authorId    String
  title       String
  status      String
  duedate     String
  description String
  properties  Json
  attachments Attachment[]
  comments    Comment[]
  author      User         @relation(fields: [authorId], references: [id])
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Comment {
  id          Int      @id @default(autoincrement())
  text        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  taskId      Int
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Attachment {
  id       String @id @default(uuid())
  taskId   Int
  filename String
  fileData Bytes
  url      String
  task     Task   @relation(fields: [taskId], references: [id])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model Invitation {
  id        String   @id @default(uuid())
  teamId    String
  email     String
  role      Role     @default(MEMBER)
  token     String   @unique
  expires   DateTime
  invitedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  user      User     @relation(fields: [invitedBy], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  teamId     String
  hashedKey  String    @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())
  expiresAt  DateTime?
  lastUsedAt DateTime?
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  OWNER
  MEMBER
  AUDITOR
}

// OSCRAT

enum OscratOrganizationRole {
  MANUFACTURER
  DISTRIBUTOR
  IMPORTER
  DATA_STEWARD
}

enum OscratOrganizationType {
  NATURAL_PERSON
  LIMITED_LIABILITY_COMPANY
  PUBLIC_LIMITED_COMPANY
  PARTNERSHIP
  OPEN_SOURCE_FOUNDATION
  OPEN_SOURCE_STEWARD
  NON_PROFIT_ORGANIZATION
  ACADEMIC_INSTITUTION
  PUBLIC_BODY
  OTHER
}

// Organization size classifications (based on EU Recommendation 2003/361/EC)
enum OscratOrganizationSize {
  MICROENTERPRISE
  SMALL_ENTERPRISE
  MEDIUM_ENTERPRISE
  LARGE_ENTERPRISE
  STARTUP
}

model OscratOrganization {
  id    String                   @id @default(uuid())
  name  String
  type  OscratOrganizationType
  size  OscratOrganizationSize
  roles OscratOrganizationRole[]

  teamId String @unique
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  products                    OscratProduct[]
  OscratReportingOrganization OscratReportingOrganization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  createdByUser User @relation("OscratOrganizationCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User @relation("OscratOrganizationUpdatedBy", fields: [updatedBy], references: [id])
}

enum OscratProductCategory {
  DEFAULT
  IMPORTANT_CLASS_I
  IMPORTANT_CLASS_II
  CRITICAL
}

enum OscratProductRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OscratProductComplianceStatus {
  NOT_ASSESSED
  IN_PROGRESS
  COMPLIANT
  NON_COMPLIANT
  PENDING_CERTIFICATION
  CERTIFIED
}

enum OscratProductType {
  // Hardware
  CONNECTED_DEVICE
  IOT_DEVICE
  SMART_HOME_DEVICE
  WEARABLE_DEVICE
  INDUSTRIAL_DEVICE
  SECURITY_HARDWARE

  // Software
  APPLICATION_SOFTWARE
  SYSTEM_SOFTWARE
  SECURITY_SOFTWARE
  EMBEDDED_SOFTWARE
  FIRMWARE

  // Hybrid
  HARDWARE_WITH_SOFTWARE
  REMOTE_DATA_PROCESSING
}

enum OscratProductStatus {
  ACTIVE
  INACTIVE
}

model OscratProduct {
  id   String @id @default(uuid())
  name String

  organizationId String
  organization   OscratOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type                   OscratProductType
  reportingOrganizations OscratReportingOrganization[]
  productCategory        OscratProductCategory         @default(DEFAULT)
  complianceStatus       OscratProductComplianceStatus @default(NOT_ASSESSED)
  conformityProcedure    OscratConformityProcedure      @default(SELF_ASSESSMENT)
  riskLevel              OscratProductRiskLevel         @default(LOW)
  assessments            OscratProductAssessment[]
  vulnerabilities        OscratProductVulnerability[]
  incidents              OscratProductIncident[]
  status                 OscratProductStatus           @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  createdByUser User @relation("OscratProductCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User @relation("OscratProductUpdatedBy", fields: [updatedBy], references: [id])
}

enum OscratConformityProcedure {
  SELF_ASSESSMENT
  THIRD_PARTY_OPTIONAL
  THIRD_PARTY_MANDATORY
  EUCC_CERTIFICATION
}

enum OscratAssessmentType {
  CRA
  ORG
}

model OscratProductAssessment {
  id String @id @default(uuid())

  type OscratAssessmentType
  schemaVersion String
  rawData       Json

  productId String
  product   OscratProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  createdBy String

  createdByUser User @relation("OscratProductAssessmentCreatedBy", fields: [createdBy], references: [id])
}

model OscratReportingOrganization {
  id             String @id @default(uuid())
  name           String
  acronym        String
  reportingEmail String

  organizationId String
  organization   OscratOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedProducts OscratProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  createdByUser User @relation("OscratReportingOrganizationCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User @relation("OscratReportingOrganizationUpdatedBy", fields: [updatedBy], references: [id])
}

enum OscratProductVulnerabilitySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OscratProductVulnerabilityStatus {
  OPEN
  ACTIVELY_EXPLOITED
  PATCHED
  MITIGATED
  CLOSED
  ACCEPTED_RISK
}

model OscratProductVulnerability {
  id String @id @default(uuid())

  name        String
  description String
  severity    OscratProductVulnerabilitySeverity
  status      OscratProductVulnerabilityStatus
  cve         String?

  productId String
  product   OscratProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  createdByUser User @relation("OscratProductVulnerabilityCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User @relation("OscratProductVulnerabilityUpdatedBy", fields: [updatedBy], references: [id])
}

enum OscratProductIncidentType {
  VULNERABILITY_EXPLOIT
  PRODUCT_COMPROMISE
  SUPPLY_CHAIN_INCIDENT
  AUTHENTICATION_BYPASS
  DATA_BREACH
  DENIAL_OF_SERVICE
  FIRMWARE_TAMPERING
  CONFIGURATION_EXPLOIT
  UPDATE_MECHANISM_FAILURE
  CRYPTOGRAPHIC_FAILURE
  NETWORK_INTRUSION
  OTHER
}

enum OscratProductIncidentStatus {
  NOT_REPORTED
  INITIAL_ALERT_SENT
  DETAILED_REPORT_SENT
  FINAL_REPORT_SENT
  REPORTING_COMPLETE
}

model OscratProductIncident {
  id String @id @default(uuid())

  name              String
  description       String
  type              OscratProductIncidentType
  status            OscratProductIncidentStatus
  incidentReference String?

  productId String
  product   OscratProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  createdByUser User @relation("OscratProductIncidentCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User @relation("OscratProductIncidentUpdatedBy", fields: [updatedBy], references: [id])
}
