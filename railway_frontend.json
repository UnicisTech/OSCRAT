{
  "build": {
    "builder": "nixpacks",
    "buildCommand": "pnpm frontend:build"
  },
  "deploy": {
    "preDeployCommand": "pnpm db:migrate:deploy",
    "startCommand": "pnpm frontend:start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 10
  },
  "watchPaths": [
    "apps/frontend/**",
    "packages/model/**",
    "package.json",
    "pnpm-lock.yaml"
  ],
  "environments": {
    "production": {
      "variables": {
        "NODE_ENV": "production",
        "DATABASE_URL": { "$ref": "DATABASE_URL" },
        "NEXTAUTH_URL": { "$ref": "NEXTAUTH_URL" },
        "NEXTAUTH_SECRET": { "$ref": "NEXTAUTH_SECRET" },
        "SMTP_HOST": { "$ref": "SMTP_HOST" },
        "SMTP_PORT": { "$ref": "SMTP_PORT" },
        "SMTP_USER": { "$ref": "SMTP_USER" },
        "SMTP_PASSWORD": { "$ref": "SMTP_PASSWORD" },
        "SMTP_FROM": { "$ref": "SMTP_FROM" },
        "APP_URL": { "$ref": "APP_URL" },
        "CONFIRM_EMAIL": { "$ref": "CONFIRM_EMAIL" },
        "SVIX_URL": { "$ref": "SVIX_URL" },
        "SVIX_API_KEY": { "$ref": "SVIX_API_KEY" },
        "NEXT_PUBLIC_MATOMO_URL": { "$ref": "NEXT_PUBLIC_MATOMO_URL" },
        "NEXT_PUBLIC_MATOMO_SITE_ID": { "$ref": "NEXT_PUBLIC_MATOMO_SITE_ID" },
        "RETRACED_URL": { "$ref": "RETRACED_URL" },
        "RETRACED_API_KEY": { "$ref": "RETRACED_API_KEY" },
        "RETRACED_PROJECT_ID": { "$ref": "RETRACED_PROJECT_ID" },
        "FEATURE_TEAM_SSO": { "$ref": "FEATURE_TEAM_SSO" },
        "FEATURE_TEAM_DSYNC": { "$ref": "FEATURE_TEAM_DSYNC" },
        "FEATURE_TEAM_AUDIT_LOG": { "$ref": "FEATURE_TEAM_AUDIT_LOG" },
        "FEATURE_TEAM_WEBHOOK": { "$ref": "FEATURE_TEAM_WEBHOOK" },
        "FEATURE_TEAM_API_KEY": { "$ref": "FEATURE_TEAM_API_KEY" }
      }
    }
  }
}
