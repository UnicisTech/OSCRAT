{
  "name": "oscrat-platform",
  "version": "0.2.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm --filter @oscrat/model generate && pnpm -r --parallel dev",
    "build": "pnpm --filter @oscrat/model generate && pnpm -r build",
    "start": "pnpm -r start",
    "check-types": "pnpm -r check-types",
    "check-format": "prettier --check .",
    "check-lint": "pnpm -r check-lint",
    "format": "prettier --write .",
    "test-all": "pnpm run check-format && pnpm run check-lint && pnpm run check-types && pnpm run build",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "frontend:dev": "pnpm --filter @oscrat/model generate && pnpm --filter @oscrat/frontend dev",
    "frontend:build": "pnpm --filter @oscrat/model generate && pnpm --filter @oscrat/frontend build",
    "frontend:start": "pnpm --filter @oscrat/frontend start",
    "db:generate": "pnpm --filter @oscrat/model generate",
    "db:push": "pnpm --filter @oscrat/model push",
    "db:studio": "pnpm --filter @oscrat/model studio",
    "db:migrate": "pnpm --filter @oscrat/model migrate",
    "db:seed": "pnpm --filter @oscrat/model seed:oscrat",
    "db:all": "pnpm run db:generate && pnpm run db:push && pnpm run db:migrate",
    "db:reset": "pnpm --filter @oscrat/model reset",
    "services:db:up": "docker-compose up -d",
    "services:db:down": "docker-compose down",
    "services:db:logs": "docker-compose logs -f",
    "services:jobrunner:up": "docker-compose --profile jobrunner up -d jobrunner",
    "services:jobrunner:down": "docker-compose --profile jobrunner down",
    "services:jobrunner:logs": "docker-compose --profile jobrunner logs -f jobrunner",
    "jobrunner:dev": "pnpm --filter @oscrat/model generate && pnpm --filter @oscrat/jobrunner dev",
    "jobrunner:build": "pnpm --filter @oscrat/model generate && pnpm --filter @oscrat/jobrunner build",
    "jobrunner:start": "pnpm --filter @oscrat/jobrunner start"
  },
  "devDependencies": {
    "@eslint/compat": "^1.1.0",
    "@trivago/prettier-plugin-sort-imports": "4.3.0",
    "@typescript-eslint/eslint-plugin": "7.12.0",
    "@typescript-eslint/parser": "7.12.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.3.0",
    "prettier-plugin-tailwindcss": "0.6.11",
    "prisma": "^6.7.0",
    "tailwindcss": "3.4.3",
    "typescript": "5.4.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "core-js",
      "esbuild",
      "prisma",
      "protobufjs",
      "sharp",
      "sqlite3"
    ],
    "ignoredBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
