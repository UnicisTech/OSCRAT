# ========================================
# OSCRAT Platform Environment Configuration
# ========================================
# Copy this file to .env and fill in the REQUIRED section.
# Everything below that is OPTIONAL — uncomment / fill in only what you use.


# ========== REQUIRED ==========
# The minimum needed for `pnpm dev` to boot against a local docker-compose db.

# Database — matches the local docker-compose `db` service (password: counter, db: unicis_platform)
DATABASE_URL=postgresql://postgres:counter@localhost:5432/unicis_platform

# App URLs (dev server runs on port 4002; keep these three in sync)
PORT=4002
APP_URL=http://localhost:4002
NEXT_PUBLIC_APP_URL=http://localhost:4002

# NextAuth
NEXTAUTH_URL=http://localhost:4002
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Application Environment
NODE_ENV=development

# When true, users must click a confirmation link emailed to them before they can sign in.
# Keep this `false` for local development — no SMTP is wired up out of the box, so
# leaving it `true` means new accounts will be stuck waiting for a confirmation email
# that never arrives.
CONFIRM_EMAIL=false


# ========== OPTIONAL: EMAIL ==========
# SMTP is used for transactional email (invitations, password resets, etc.).
# Get free SMTP credentials from Brevo: https://app.brevo.com/settings/keys/smtp

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=


# ========== OPTIONAL: AUTHENTICATION PROVIDERS ==========
# Comma-separated list of enabled providers. Supported: github, google, saml, email, credentials
AUTH_PROVIDERS=email,credentials

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SAML Jackson (self-hosted SAML/OIDC + Directory Sync).
# Leave JACKSON_URL unset to disable self-hosted mode.
JACKSON_URL=
JACKSON_EXTERNAL_URL=
JACKSON_API_KEY=
JACKSON_PRODUCT_ID=boxyhq
JACKSON_WEBHOOK_SECRET=

# Group prefix for SSO groups (e.g., boxyhq-admin -> admin)
GROUP_PREFIX=boxyhq-


# ========== OPTIONAL: APPLICATION FEATURES ==========
# All of these have sensible defaults in code — override only if you need to.

HIDE_LANDING_PAGE=true
DISABLE_NON_BUSINESS_EMAIL_SIGNUP=false

FEATURE_TEAM_SSO=true
FEATURE_TEAM_DSYNC=true
FEATURE_TEAM_AUDIT_LOG=true
FEATURE_TEAM_WEBHOOK=true
FEATURE_TEAM_API_KEY=true


# ========== OPTIONAL: EXTERNAL SERVICES ==========

# Svix (webhook orchestration)
SVIX_URL=https://api.eu.svix.com
SVIX_API_KEY=

# Public frontend flags (exposed to the browser)
NEXT_PUBLIC_DARK_MODE=true
# NEXT_PUBLIC_MIXPANEL_TOKEN=

# Matomo analytics
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=

# Google reCAPTCHA
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=


# ========== OPTIONAL: OBSERVABILITY ==========

OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_HEADERS=
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=grpc
OTEL_PREFIX=oscrat


# ========== OPTIONAL: JOB RUNNER OVERRIDES ==========
# All of these have defaults in code.

JOBRUNNER_PORT=3001
JOB_POLL_INTERVAL_MS=5000
MAX_CONCURRENT_JOBS=3
# Working directory for SBOM / vulnerability scan artifacts (defaults to /tmp/jobrunner-workspace)
JOBRUNNER_WORKSPACE_ROOT=
