# ========================================
# OSCRAT Platform Environment Configuration
# ========================================
# Copy this file to .env and update with your values

# ========== SHARED CONFIGURATION ==========

# Database (used by all packages)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unicis_platform
DATABASE_PORT=5432

# Application Environment
NODE_ENV=development

# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ========== FRONTEND (apps/frontend) ==========

# Server Configuration
PORT=4002
NEXTAUTH_URL=http://localhost:4002
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here
APP_URL=http://localhost:4002
NEXT_PUBLIC_APP_URL=http://localhost:4002

# Email Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Authentication Providers
# Supported: github, google, saml, email, credentials
AUTH_PROVIDERS=email,credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Application Features
HIDE_LANDING_PAGE=true
CONFIRM_EMAIL=false
DISABLE_NON_BUSINESS_EMAIL_SIGNUP=false

# SSO Configuration
# Group prefix for SSO groups (e.g., boxyhq-admin -> admin)
GROUP_PREFIX=boxyhq-

# Team Features
FEATURE_TEAM_SSO=true
FEATURE_TEAM_DSYNC=true
FEATURE_TEAM_AUDIT_LOG=true
FEATURE_TEAM_WEBHOOK=true
FEATURE_TEAM_API_KEY=true

# Public Frontend Variables (exposed to browser)
NEXT_PUBLIC_DARK_MODE=true
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
# NEXT_PUBLIC_MIXPANEL_TOKEN=

# External Services
SVIX_URL=https://api.eu.svix.com
SVIX_API_KEY=

# Google reCAPTCHA (optional)
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# OpenTelemetry Monitoring (optional)
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_HEADERS=
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=grpc
OTEL_EXPORTER_DEBUG=false
OTEL_PREFIX=oscrat

# ========== JOB RUNNER (apps/jobrunner) ==========

# Job Runner Configuration
JOBRUNNER_PORT=3001
JOB_POLL_INTERVAL_MS=5000
MAX_CONCURRENT_JOBS=3