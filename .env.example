# ========== REQUIRED ==========

DATABASE_URL=postgresql://postgres:counter@localhost:5432/unicis_platform

PORT=4002
APP_URL=http://localhost:4002
NEXT_PUBLIC_APP_URL=http://localhost:4002

NEXTAUTH_URL=http://localhost:4002
NEXTAUTH_SECRET=your-nextauth-secret-here
TOKEN_ENCRYPTION_KEY=

NODE_ENV=development
CONFIRM_EMAIL=false

# ========== EMAIL (SMTP) ==========

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ========== AUTH PROVIDERS ==========

AUTH_PROVIDERS=email,credentials

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SAML / Directory Sync
JACKSON_URL=
JACKSON_EXTERNAL_URL=
JACKSON_API_KEY=
JACKSON_PRODUCT_ID=boxyhq
JACKSON_WEBHOOK_SECRET=
GROUP_PREFIX=boxyhq-

# ========== FEATURES ==========

HIDE_LANDING_PAGE=true
DISABLE_NON_BUSINESS_EMAIL_SIGNUP=false

FEATURE_TEAM_SSO=true
FEATURE_TEAM_DSYNC=true
FEATURE_TEAM_AUDIT_LOG=true
FEATURE_TEAM_WEBHOOK=true
FEATURE_TEAM_API_KEY=true

# ========== EXTERNAL SERVICES ==========

SVIX_URL=https://api.eu.svix.com
SVIX_API_KEY=

NEXT_PUBLIC_DARK_MODE=true

# ========== OBSERVABILITY ==========

OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_HEADERS=
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=grpc
OTEL_PREFIX=oscrat

# ========== JOB RUNNER ==========

JOBRUNNER_PORT=3001
JOB_POLL_INTERVAL_MS=5000
MAX_CONCURRENT_JOBS=3
JOBRUNNER_WORKSPACE_ROOT=
