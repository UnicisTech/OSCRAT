# Port configuration
PORT=4002

# Only required for localhost
NEXTAUTH_URL=http://localhost:${PORT}
# You can use openssl to generate a random 32 character key: openssl rand -base64 32
NEXTAUTH_SECRET=<NEXTAUTH_SECRET KEY HERE>

# SMTP / Email settings
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=test@example.com

# Database configuration
DATABASE_PORT=5432
# If you are using Docker, you can retrieve the values from: docker-compose.yml
#DATABASE_URL=postgresql://postgres:Thegodofthunderishere@db.nqofmoqjkzapacwoaszh.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:counter@localhost:${DATABASE_PORT}/unicis_platform
#DATABASE_URL=postgres://postgres.izpnmejqgftqnyiysrdu:YAUEKDlIcCbagdp5@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require&supa=base-pooler.x&pgbouncer=true&prepared_statements=false

APP_URL=http://localhost:${PORT}
SVIX_URL=https://api.eu.svix.com
SVIX_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RETRACED_URL=
RETRACED_API_KEY=
RETRACED_PROJECT_ID=

# Hide landing page and redirect to login page
HIDE_LANDING_PAGE=true

# SSO groups can be prefixed with this identifier in order to avoid conflicts with other groups.
# For example boxyhq-admin would be resolved to admin, boxyhq-member would be resolved to member, etc.
GROUP_PREFIX=boxyhq-

# Users will need to confirm their email before accessing the app feature
CONFIRM_EMAIL=false

# Disable non-business email signup
DISABLE_NON_BUSINESS_EMAIL_SIGNUP=false

# Mixpanel
# NEXT_PUBLIC_MIXPANEL_TOKEN=

# Enable Auth providers (comma separated)
# Supported providers: github, google, saml, email, credentials
AUTH_PROVIDERS=email,credentials

# OpenTelemetry
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_HEADERS=
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=grpc
OTEL_EXPORTER_DEBUG=true
OTEL_PREFIX=boxyhq.saas

NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_DARK_MODE=true

# Team feature
FEATURE_TEAM_SSO=true
FEATURE_TEAM_DSYNC=true
FEATURE_TEAM_AUDIT_LOG=true
FEATURE_TEAM_WEBHOOK=true
FEATURE_TEAM_API_KEY=true

# Google reCAPTCHA
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=