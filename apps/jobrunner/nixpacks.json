{
  "phases": {
    "setup": {
      "nixPkgs": ["...", "nodejs", "syft", "grype", "python3", "python3Packages.pip"]
    },
    "openscap": {
      "dependsOn": ["install"],
      "cmds": [
        "python3 -m venv /opt/openscap-venv",
        "/opt/openscap-venv/bin/pip install openscap-report==1.0.0",
        "ln -sf /opt/openscap-venv/bin/oscap-report /usr/bin/oscap-report"
      ]
    }
  }
}
