{
  "phases": {
    "setup": {
      "nixPkgs": ["...", "nodejs", "syft", "python3", "python3Packages.pip", "curl"]
    },
    "grype": {
      "dependsOn": ["setup"],
      "cmds": [
        "curl -sSfL https://raw.githubusercontent.com/anchore/grype/v0.116.0/install.sh | sh -s -- -b /usr/local/bin v0.116.0",
        "ln -sf /usr/local/bin/grype /usr/bin/grype"
      ]
    },
    "openscap": {
      "dependsOn": ["install"],
      "cmds": [
        "python3 -m venv /opt/openscap-venv",
        "/opt/openscap-venv/bin/pip install openscap-report==1.0.0",
        "ln -sf /opt/openscap-venv/bin/oscap-report /usr/bin/oscap-report"
      ]
    }
  }
}
